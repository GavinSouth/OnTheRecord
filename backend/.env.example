# Copy to backend/.env (git-ignored) and change the password. Local development only.
OTR_ENV=dev

# Used by compose.yaml to create the local Postgres.
POSTGRES_USER=ontherecord
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ontherecord
POSTGRES_PORT=5432

# The app and Alembic connect with this (keep it in sync with the values above).
OTR_DATABASE_URL=postgresql+psycopg://ontherecord:change-me@localhost:5432/ontherecord
# Optional: Alembic connects with this instead (prod: otr_owner; the API uses otr_app).
# Locally, leave it unset to migrate with the URL above.
# OTR_MIGRATIONS_DATABASE_URL=postgresql+psycopg://otr_owner:...@localhost:5432/ontherecord
# Tests use a separate database on the same server; it's created automatically.
OTR_TEST_DATABASE_URL=postgresql+psycopg://ontherecord:change-me@localhost:5432/ontherecord_test

# Signs access tokens; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OTR_JWT_SECRET=
# Apple sign-in audiences (iOS bundle id, web Services ID) as a JSON list.
# Empty in dev: use POST /api/v1/auth/dev instead. Required in prod.
OTR_APPLE_CLIENT_IDS=[]
